{
  "manifest_version": 3,
  "name": "Oopsie",
  "short_name": "Oopsie",
  "version": "1.0.0",
  "description": "Oops less. Do more. Daily to-dos, reminders and follow-ups — right in your browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Oopsie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "contextMenus", "activeTab", "offscreen"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O", "mac": "Alt+Shift+O" },
      "description": "Open the Oopsie popup (quick add)"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+U", "mac": "Alt+Shift+U" },
      "description": "Open the Oopsie dashboard"
    },
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Save the current page as an Oopsie task"
    }
  }
}
